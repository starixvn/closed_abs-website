<?xml version="1.0"?>
<LogSection>
    <LogType>
        <type id="1" name="setting" isTracking="true"></type>
        <type id="2" name="status" isTracking="true"></type>
        <type id="3" name="credit" isTracking="false"></type>
        <type id="4" name="login" isTracking="false"></type>
    </LogType>
    <TrackingTemplate>
        <tracking level="1" action="*" hasGroup="false" isDefault="true" hiddenDefault="custid,userid,username">
            <filters>
                <!-- only racing -->
                <action id="321" prefix="v151_51" regx="(minb|maxb|mpm)"></action>
                <action id="322" prefix="v151_51" regx="(minb|maxb|mpm)"></action>
                <action id="323" prefix="v151_51" regx="(minb|maxb|mpm)"></action>
                <action id="324" prefix="v151_51" regx="(minb|maxb|mpm)"></action>
