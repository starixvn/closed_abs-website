                <action id="2006" prefix="v153_51" regx="(minb|maxb|mpm)"></action>

                <action id="627" hidden="custid,userid"></action>
            </filters>
            <formater>
                <param name="transferoption"></param>
                <param name="ip"></param>
            </formater>
        </tracking>
        <tracking level="2" action="*" hasGroup="false" isDefault="false" hiddenDefault="custid,userid,username">
            <filters>
                <action id="406"></action>
                <action id="418"></action>
                <action id="419"></action>
                <action id="420"></action>
                <action id="421"></action>
            </filters>
            <formater>
                <param name="transferoption"></param>
                <param name="ip"></param>
            </formater>
        </tracking>
        <tracking level="3" action="*" hasGroup="true" hiddenDefault="custid,userid,username,UMMBv1,UMMBv2,UMMBv3,UMMBv5,UMMBv8,UMMBv10,UMMBv11,UMMBv99,UMMBv99MP,UMMBv161,MaxBv201,MinBv201,MPMv201,UMMBv201" groupDefault="sportbook">
