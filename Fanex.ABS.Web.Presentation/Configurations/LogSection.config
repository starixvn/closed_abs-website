                <action id="302"></action>
                <action id="303"></action>
                <action id="304"></action>
                <action id="2000"></action>
                <action id="407"></action>
                <action id="412"></action>
                <action id="413"></action>
                <action id="307"></action>
                <action id="313"></action>
                <action id="314"></action>
            </filters>
        </tracking>
    </TrackingTemplate>
    <Groups>
        <group name="sportbook">
            <sports>
                <add id="1" label="soccer"></add>
                <add id="2" label="basketball"></add>
                <add id="3" label="football"></add>
                <add id="5" label="tennis"></add>
                <add id="8" label="baseball"></add>
                <add id="10" label="Golf"></add>
                <add id="11" label="motorsports"></add>
                <add id="99" label="othersports"></add>
                <add id="999" label="mixsportparlay"></add>
                <add id="161" label="numbergame"></add>
            </sports>
        </group>
    </Groups>
    <LogFormater>
        <param name="transferoption" value="1"></param>
        <param name="ip" value="2"></param>
    </LogFormater>
</LogSection>
