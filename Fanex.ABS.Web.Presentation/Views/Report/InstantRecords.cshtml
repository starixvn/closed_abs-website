@using Fanex.ABS.Infrastructure.Configurations;
@{
    Layout = null;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Instant Records</title>
    <link href="~/Scripts/Lib/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/Scripts/Lib/MultipleSelect/jquery.multiselect.css" rel="stylesheet"
        type="text/css" />
    <link href="~/Views/Report/Styles/InstantReport.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Ocean/Grid.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Ocean/StyleSheet.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <div id="headerSection">
        <a href="javascript:void(0)" id="btnToggle" class="toggler" title="Expand/Collapse Add Member">
        </a>
        <div class="pageTitle">
            Instant Records</div>
        <div class="filterSection" id="filterSection">
            <table id="reportFilter" style="width: 100%;" cellspacing="0" cellpadding="0">
                <tr>
                    <td class="l w60">
                        <label>
                            Date:</label>
                    </td>
                    <td class="l">
                        <input class="inputtext txtdate" id="txtdate" readonly="readonly" style="width: 80px;" />
                    </td>
                    <td class="l w60">
                        <label>
                            League:</label>
                    </td>
                    <td class="l">
                        <div id="ddlLeague" class="multiselect w260" multiple="multiple">
                        </div>
                    </td>
                    <td class="l w60">
                        <label>
                            Account:</label>
                    </td>
                    <td class="l">
                        <div id="ddlAccount" class="multiselect w160" multiple="multiple">
                        </div>
                    </td>
                    <td class="l w80">
                        <label id="lblrefresh">
                            Refresh Time:</label>
                    </td>
                    <td class="l">
                        <select id="ddlRefreshTime" class="w80 inputtext">
                            <option value="10" selected="selected">10 sec</option>
                            <option value="15">15 sec</option>
                            <option value="30">30 sec</option>
                            <option value="60">60 sec</option>
                            <option value="90">90 sec</option>
                            <option value="120">120 sec</option>
                            <option value="0">Never</option>
                        </select>
                    </td>
                    <td class="w80 r">
                        <input type="button" id="btnRefresh" class="btn" value="Refresh" />
                    </td>
                </tr>
            </table>
            <table id="tblHours" style="margin-top: 6px; width: 100%;">
            </table>
            <div id="reportInfo" class="hidden" style="margin-top: 6px;">
                <div id="infoInstantReport">
                    <span id="currDate"></span>&nbsp;&nbsp;<span class="timeSelections">Time Selection:
                        <span id="timeSelections" class="b">AllPeriod</span></span> <span class="spmatch">FT
                            Match(s)</span> &nbsp;&nbsp;<span id="runningMatch" class="disabled">[SP Match(s)]</span>
                    <span id="completeMatch">[FT Match(s)]</span>
                </div>
            </div>
        </div>
        <div id="msg" style="width: 100%;">
        </div>
    </div>
    <div id="contentSection" style="padding-top: 160px;">
        <div id="reportGrid" style="margin-top: 6px;" class="hidden">
            <table class="oceanTbl" id="tblInstantRecord" style="width: 100%">
                <thead>
                    <tr class="header">
                        <td class="col30 c">
                            #
                        </td>
                        <td class="col60 c">
                            Id
                        </td>
                        <td class="col80 c">
                            Entry Time
                        </td>
                        <td class="col80 c">
                            Match Date
                        </td>
                        <td class="col60 c">
                            Acc
                        </td>
                        <td class="col80 c">
                            BT
                        </td>
                        <td class="c">
                            Match Detail
                        </td>
                        <td class="col100 c">
                            Team Pick
                        </td>
                        <td class="col60 c">
                            HDP/Goal
                        </td>
                        <td class="col60 c">
                            Odds
                        </td>
                        <td class="col60 c">
                            Stake
                        </td>
                        <td class="col120 c">
                            Remarks
                        </td>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                <tfoot>
                    <tr class="header">
                        <td colspan="12">
                            <a href="javascript:void(0)" id="lnkmorebets" onclick="reportContent.showFullBets();">
                                More...</a>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div id="divEditRemark" style="display: none">
        <div id="divMsgRemark" style="width: 354px; padding-left: 4px; padding-bottom: 2px;
            padding-top: 2px; margin-top: 2px;">
        </div>
        <table border="0" style="margin-top: 2px">
            <tr>
                <td valign="top">
                    <label>
                        Content:</label>
                </td>
                <td>
                    <textarea id="txtRemark" style="width: 300px; height: 80px; resize: none" rows="10"
                        cols="100"></textarea>
                </td>
            </tr>
        </table>
    </div>
    <script src="~/Scripts/Lib/jquery.min.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/Jlinq/jlinq.jquery.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/UI/jquery-ui-1.8.16.custom.min.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/jquery.imgpreload.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/json2.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/utils/jquery.button.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/Popup/js/centreIt-1.1.5.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/Popup/js/jquery.popup.js" type="text/javascript"></script>
    <script src="~/Scripts/Common.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/MultipleSelect/jquery.multiselect.js" type="text/javascript"></script>
    <script src="~/Views/Report/Scripts/InstantRecords.js?ver=@WebSettings.Version" type="text/javascript"></script>
    <script type="text/javascript">
        var colorFilter = "@ViewBag.ColorFilter";
        var toDate = "@ViewBag.ToDate";
    </script>
</body>
</html>