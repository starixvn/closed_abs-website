@using Fanex.ABS.Infrastructure.Configurations;
@{
    Layout = null;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>EM & FT</title>
    <link href="~/Scripts/Lib/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/Views/Report/Styles/InstantReport.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Ocean/Grid.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Ocean/StyleSheet.css" rel="stylesheet" type="text/css" />
    <style type="text/css">
        body
        {
            float: left;
        }
        .c
        {
            text-align: center !important;
        }
        .bgheader
        {
            background-color: #DBE5F9 !important;
            color: #000;
        }
        .col-event
        {
            width: 849px;
        }
        .col655
        {
            white-space: normal;
            width: 455px;
            word-wrap: break-word;
        }
        .col580
        {
            white-space: normal;
            width: 571px;
            word-wrap: break-word;
        }
        .b-top
        {
            border-top: 1px solid #BABABA !important;
        }
        .nb-bottom
        {
            border-bottom: none !important;
        }
        .nb-right
        {
            border-right: none !important;
        }
        .upper
        {
            text-transform: uppercase;
        }
        .uc-first
        {
            text-transform: capitalize;
        }
        .teamname
        {
            padding-left: 6px;
            text-align: left;
        }
        .ht
        {
            color: #6678E0;
        }
        .at
        {
            color: #008D95;
        }
        .htsc
        {
            color: #6877B4;
        }
        .red
        {
            color: #FF0000;
        }
        div.leaguename
        {
            float: left;
            width: 942px;
            padding-left: 10px;
            cursor: pointer;
        }
        div.leaguename span
        {
            background: url("@Url.Content("~/Views/Report/images/icon_arrow_down.gif")") no-repeat scroll left center transparent;
            padding-left: 20px;
        }
        div.leaguename span.up
        {
            background: url("@Url.Content("~/Views/Report/images/icon_arrow_up.gif")") no-repeat scroll left center transparent;
        }
        .content-warper
        {
            float: left;
        }
        .bg-league
        {
            background-color: #EDECEB;
        }
        /** collapse **/
        div.collapse
        {
            cursor: pointer;
        }
        div.collapse span
        {
            background: url("@Url.Content("~/Views/Report/images/icon_down.gif")") no-repeat scroll left top transparent;
            padding-left: 20px;
        }
        div.collapse span.up
        {
            background: url("@Url.Content("~/Views/Report/images/icon_up.gif")") no-repeat scroll left top transparent !important;
        }
        /**max height**/
        .scroll-height
        {
            overflow: hidden;
            width: 954px;
        }
        .event-764
        {
            width: 764px;
        }
        .event-711
        {
            width: 711px;
        }
        .event-652
        {
            width: 652px;
        }
        .event-571
        {
            width: 571px;
        }
        .event-431
        {
            width: 431px;
        }
        .event-574
        {
            width: 574px;
        }
        .noinfo
        {
            text-align: center;
            width: 952px;
        }
        .goal-history
        {
            color: #0000FF;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div id="headerSection">
        <a href="javascript:void(0)" id="btnToggle" class="toggler" title="Expand/Collapse">
            &nbsp;</a>
        <div class="pageTitle">
            EM & FT</div>
        <div class="filterSection" id="filterSection" style="width: 942px">
            <table id="reportFilter">
                <tr>
                    <td class="r">
                        <label>
                            Date:</label>
                    </td>
                    <td class="l">
                        <input class="inputtext txtdate" id="txtdate" readonly="readonly" style="width: 80px;" />
                    </td>
                    <td class="r w60">
                        <label>
                            Leagues:</label>
                    </td>
                    <td class="l">
                        <select id="ddlLeague" class="w260 inputtext">
                        </select>
                    </td>
                    <td class="w80 r">
                        <input type="button" id="btnSubmit" class="btn" value="Submit" />
                    </td>
                </tr>
            </table>
        </div>
        <div id="msg" style="width: 100%;">
        </div>
    </div>
    <div id="contentSection" style="padding-top: 74px;">
    </div>
    <script id="tpl-soccer" type="text/html">
        <div class="content-warper" style="margin-top: 6px; width: 954px;">
            <div class="content-header clearfix" >
                <div class="header-scroll" style="width:954px">
                    <table class="tbl-header-scroll" style="">
                        <tbody>
                            <tr valign="middle" style="height: 25px">
                                <td colspan="8" class="nb-right">
                                    <div style="float:left" class="col100 upper collapse" rel="${ID}"><span id="sport_${ID}">${Name}</span></div>
                                    <div style="float:left" class="col-event c collapse" rel="${ID}">
                                        EVENT ${EventDate}
                                    </div>
                                </td>
                            </tr>
                            <tr class="header_${ID}" align="center">
                                <td class="bgheader">
                                    <div class="col100">MATCH-CODE</div>
                                </td>
                                <td class="bgheader">
                                    <div class="col120">KICK-OFF TIME</div>
                                </td>
                                <td class="bgheader">
                                    <div class="col655 teamname" style="text-align:center!important;">EVENT</div>
                                </td>
                                <td class="bgheader">
                                    <div class="col50">HT<br>
                                    SCORE</div>
                                </td>
                                <td class="bgheader">
                                    <div class="col50">FINAL<br>
                                    SCORE</div>
                                </td>
                                <td class="bgheader">
                                    <div class="col25">FG</div>
                                </td>
                                <td class="bgheader">
                                    <div class="col25">LG</div>
                                </td>
                                <td class="bgheader">
                                    <div class="col100">EVENT<br>
                                    STATUS</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div id="l_sport_${ID}" class="content-body clearfix nb-bottom">
                <div class="body-scroll scroll-height" style="overflow:hidden;">
                    <table class="tbl-body-scroll" style="">
                        <tbody>
                            {{html $item.genLeague($data.Leagues) }}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </script>
    <script id="tpl-soccer-league" type="text/html">
        <tr class="l">
            <td colspan="8" class="bg-league">
                <div class="b leaguename" rel="${League}"><span id="league_${League}" rel="${Sport}">${LeagueName}</span></div>
            </td>
        </tr>
        <tr>
            <td colspan="8" style="padding:0px 0px; border: none;">
                <div id="m_league_${League}"><table id="tbl_league_${League}" class="tbl-body-scroll"><tbody>
                    {{if Matches.length}}
                    {{else}}
                    <tr class="c">
                        <td colspan="8"><div class="noinfo">There is no information.</div></td>
                    </tr>
                    {{/if}}
                </tbody></table></div>
            </td>
        </tr>
    </script>
    <script id="tpl-soccer-row" type="text/html">
        <tr class="league_${League} l">
            <td rowspan="2">
                <div class="col100 c">${Code}</div>
            </td>
            <td rowspan="2">
                <div class="col120">${KickOffTime}</div>
            </td>
            <td class="nb-bottom">
                <div class="col655 b teamname ht"><span id="home_${ID}">${HTeam}</span></div>
            </td>
            <td class="nb-bottom">
               <div class="col50 c htsc">${Param.Score.HomeHT}</div>
            </td>
            <td class="nb-bottom">
                <div class="col50 c red">${Param.Score.HomeFT}</div>
            </td>
            <td class="nb-bottom">
                <div class="col25 c">${Param.Goal.HomeFG}</div>
            </td>
            <td class="nb-bottom">
                <div class="col25 c">${Param.Goal.HomeLG}</div>
            </td>
            <td rowspan="2">
                <div class="col100 c">
                    <span class="uc-first" history="${Param.Goal.History}">${Status}</span>
                    {{if Param.Goal.History != null && Param.Goal.History != ""}}
                    <br />
                    <a title="View goal history" class="goal-history" href="javascript:;" rel="${League}|${ID}" his="${Param.Goal.History}"><span>[i]</span></a>
                    {{/if}}
                </div>
            </td>
        </tr>
        <tr class="league_${League} c">
            <td>
                <div class="col655 b teamname at b-top"><span id="away_${ID}">${ATeam}</span></div>
            </td>
            <td>
                <div class="col50 c b-top htsc">${Param.Score.AwayHT}</div>
            </td>
            <td>
                <div class="col50 c b-top red">${Param.Score.AwayFT}</div>
            </td>
            <td>
                <div class="col25 c b-top">${Param.Goal.AwayFG}</div>
            </td>
            <td>
                <div class="col25 c b-top">${Param.Goal.AwayLG}</div>
            </td>
        </tr>
    </script>
