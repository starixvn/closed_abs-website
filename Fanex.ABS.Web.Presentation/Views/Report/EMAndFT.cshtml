                    <div id="m_league_${League}"><table class="tbl-body-scroll"><tbody>
                        {{if Matches.length}}
                        {{tmpl(Matches) "#tpl-common-row"}}
                        {{else}}
                        <tr class="c">
                            <td colspan="6"><div class="noinfo">There is no information.</div></td>
                        </tr>
                        {{/if}}
                    </tbody></table></div>
                </td>
            </tr>
    </script>
    <script id="tpl-common-row" type="text/html">
        <tr class="league_${League} l">
            <td rowspan="2">
                <div class="col100 c">${Code}</div>
            </td>
            <td rowspan="2">
                <div class="col120">${KickOffTime}</div>
            </td>
            <td class="nb-bottom">
                <div class="event-711 b teamname ht">${HTeam}</div>
            </td>
            <td class="nb-bottom">
                <div class="col50 c htsc">${Param.Score.HomeHT}</div>
            </td>
            <td class="nb-bottom">
                <div class="col50 c red">${Param.Score.HomeFT}</div>
            </td>
            <td rowspan="2">
                <div class="col100 c uc-first">${Status}</div>
            </td>
        </tr>
        <tr class="league_${League} c">
            <td>
                <div class="event-711 b teamname at b-top">${ATeam}</div>
            </td>
            <td>
                <div class="col50 c b-top htsc">${Param.Score.AwayHT}</div>
            </td>
            <td>
                <div class="col50 c b-top red">${Param.Score.AwayFT}</div>
            </td>
        </tr>
    </script>
    <script id="tpl-horseracing" type="text/html">
        <div class="content-warper" style="margin-top: 6px; width: 1172px;">
            <div class="content-header clearfix" >
                <div class="header-scroll" style="width:1172px">
                    <table class="tbl-header-scroll" style="">
                        <tbody>
                            <tr valign="middle" style="height: 25px">
                                <td colspan="5" class="nb-right">
                                    <div style="float:left" class="col110 upper collapse" rel="${ID}"><span>${Name}</span></div>
                                    <div style="float:left" class="col-event c collapse" rel="${ID}">
                                        EVENT ${EventDate}
                                    </div>
                                </td>
                            </tr>
                            <tr class="header_${ID}" align="center">
                                <td class="bgheader">
                                    <div class="event-574 teamname c">RACE</div>
                                </td>
                                <td class="bgheader" style="">
                                    <div class="col200">RESULT</div>
                                </td>
                                <td class="bgheader" style="">
                                    <div class="col120">WIN</div>
                                </td>
                                <td class="bgheader" style="">
                                    <div class="col120">PLACE</div>
                                </td>
                                <td class="bgheader" style="">
                                    <div class="col120">STATUS</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div id="l_sport_${ID}" class="content-body clearfix nb-bottom">
                <div class="body-scroll scroll-height" style="overflow:hidden;">
                    <table class="tbl-body-scroll" style="">
                        <tbody>
                            {{each Leagues}}
                            <tr class="l">
                                <td colspan="5" class="bg-league">
                                    <div class="b leaguename" rel="${$value.League}"><span>${$value.LeagueName}</span></div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5" style="padding:0px 0px; border: none;">
                                    <div id="m_league_${$value.League}"><table class="tbl-body-scroll"><tbody>
                                        {{if $value.Horses.length}}
                                        {{each $value.Horses}}
                                        <tr class="l">
                                            <td rowspan="2">
                                                <div class="event-574 teamname c">${$value.RaceNo}</div>
                                            </td>
                                            <td>
                                                <div class="col200">${$value.HorseName}</div>
                                            </td>
                                            <td>
                                                <div class="col120">${$value.Winodds}</div>
                                            </td>
                                            <td>
                                                <div class="col120">${$value.Placeodds}</div>
                                            </td>
                                            <td rowspan="2">
                                                <div class="col120">${$value.Status}</div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="col200">${$value.HorseName}</div>
                                            </td>
                                            <td>
                                                <div class="col120">${$value.Winodds}</div>
                                            </td>
                                            <td>
                                                <div class="col120">${$value.Placeodds}</div>
                                            </td>
                                        </tr>
                                        {{/each}}
                                        {{else}}
                                        <tr class="c">
                                            <td colspan="5"><div class="noinfo">There is no information.</div></td>
                                        </tr>
                                        {{/if}}
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </script>
    <script id="tpl-goal-history" type="text/html">
        <div style="float: left; overflow-x:hidden;overflow-y:auto; width: 353px; height:155px;margin-top:5px;line-height:17px;border:1px solid #BABABA;">
            <table class="tbl-body-scroll" style="width: 100%;padding:1px;">
                <tbody>
                <tr align="center" style="background-color:#3B5998;color:#FFF"><td colspan="2" class="nb-right"><span class="b upper">${sport}</span></td></tr>
                <tr align="center" style="background-color:#EDECEB;font-weight:bold"><td colspan="2" class="nb-right"><span>${league}</span></td></tr>
                <tr align="center"><td colspan="2" class="nb-right"><span class="ht">${home}</span> -vs- <span class="at">${away}</span></td></tr>
                {{each records}}
                    <tr align="center"><td class="col180">${hs} - ${as}</td><td class="col180 nb-right"><span class="b">${tn}</span></td></tr>
                {{/each}}
                </tbody>
            </table>
        </div>
    </script>
    <div id="popup-history" class="hidden">
    </div>
    <script src="~/Scripts/Lib/jquery.min.js" type="text/javascript"></script>
