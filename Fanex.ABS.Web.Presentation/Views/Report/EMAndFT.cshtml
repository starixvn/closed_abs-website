    <script src="~/Scripts/Lib/Popup/js/jquery.popup.js" type="text/javascript"></script>
    <script src="~/Scripts/Common.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/gridscroller.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/jquery.tmpl.min.js" type="text/javascript"></script>
    <script src="~/Views/Report/Scripts/EMAndFT.js?ver=@WebSettings.Version" type="text/javascript"></script>
    <script type="text/javascript">
        var toDate = "@DateTime.Now.ToShortDateString()";
        $(document).ready(function () {
            EMAndFT.initPage();
        });
    </script>
</body>
