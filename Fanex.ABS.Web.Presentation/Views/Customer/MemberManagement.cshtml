@using Fanex.ABS.Infrastructure.Configurations;
@{
    Layout = null;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <link href="~/Scripts/Lib/Pager/pagination.css" rel="stylesheet" type="text/css" />
    <link href="~/Scripts/Lib/autocomplete/styles.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Ocean/Grid.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Ocean/StyleSheet.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="pageTitle">
        Member Management</div>
    <div class="filterSection" style="width: 828px">
        <a href="javascript:void(0)" id="btnToggle" class="toggler" title="Expand/Collapse Add Member">
        </a>
        <div class="pageSubTitle">
            Add Member</div>
        <table id="tblAddMember" border="0" cellpadding="2">
            <tr>
                <td class="r w80">
                    <label>
                        Username:</label>
                </td>
                <td class="l">
                    <input type="text" id="txtUsername" class="w120 inputtext" />
                </td>
                <td class="r w80">
                    <label>
                        Category:</label>
                </td>
                <td class="b l">
                    <select id="ddlCategory" class="selectw120 inputtext">
                    </select>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td class="r">
                    <label>
                        Punter Level:</label>
                </td>
                <td class="l">
                    <input type="text" id="txtPunterCode" class="w120 inputtext" maxlength="10" />
                </td>
                <td class="r">
                    <label>
                        ABT Danger:</label>
                </td>
                <td class="l">
                    <select id="ddlDanger" class="selectw120 inputtext">
                    </select>
                </td>
                <td class="r w80">
                    <label>
                        Color:</label>
                </td>
                <td class="l">
                    <select id="ddlColorFilter" class="w80 inputtext colorpicker">
                    </select>
                </td>
                <td class="l">
                </td>
            </tr>
            <tr>
                <td class="r">
                    <label>
                        FB AH:</label>
                </td>
                <td class="l">
                    <input type="text" id="txtMinBet" class="w120 noneDecimal inputtext" value="0" />
                </td>
                <td class="r">
                    <label>
                        FB OU:</label>
                </td>
                <td class="l">
                    <input type="text" id="txtMaxBet" class="w120 noneDecimal inputtext" value="0" />
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td>
                </td>
                <td class="l">
                    <input type="button" value="Add Member" id="btnAddMember" class="btn" onclick="dataProcess.insMember();" />
                </td>
                <td colspan="5">
                </td>
            </tr>
        </table>
    </div>
    <div id="msg" style="width: 788px;">
    </div>
    <div class="contentSection">
        <table>
            <tr>
                <td class="r w80">
                    <label>
                        Username:</label>
                </td>
                <td class="l">
                    <input type="text" id="txtFilterUsername" class="w120 inputtext" />
                </td>
                <td class="r w80">
                    <label>
                        ABT Danger:</label>
                </td>
                <td class="l">
                    <select id="ddlFilterDanger" class="w80 inputtext">
                    </select>
                </td>
                <td class="r w80">
                    <label>
                        Status:</label>
                </td>
                <td class="l">
                    <select id="ddlUserStatus" class="w80 inputtext">
                        <option value="2">All</option>
                        <option value="1">Enabled</option>
                        <option value="0">Disabled</option>
                    </select>
                </td>
                <td class="w80 r">
                    <input type="button" id="btnGO" class="btn" value="GO" onclick="memberManager.btnGO();" />
                </td>
            </tr>
        </table>
        <div id="memberList" class="content-warper hidden" style="margin-top: 6px;">
            <div class="content-header clearfix">
                <div class="header-scroll">
                    <table class="tbl-header-scroll">
                        <tr>
                            <td style="border-bottom: none 0px;">
                                <div class="col40 c">
                                    #</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col120 c">
                                    Username</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col80 c">
                                    Punter Level</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col80 c">
                                    Category</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col80 c">
                                    ABT Danger</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col100 c">
                                    Color</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col80 c">
                                    FB AH</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col80 c">
                                    FB OU</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col60 c">
                                    Enabled</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col60 c">
                                    Edit</div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="content-body clearfix">
                <div class="body-scroll">
                    <table id="tblMemberList" class="tbl-body-scroll">
                    </table>
                </div>
            </div>
            <div class="content-pagination bgtitle clearfix">
                <div class="pagination-scroll">
                    <table style="width: 100%" cellspacing="0" cellpadding="1">
                        <tr>
                            <td>
                                <div id="pagination">
                                    &nbsp;</div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        var categoryConfig = "@ViewBag.CategoryConfig";
        var abtDangerConfig = "@ViewBag.ABTDangerConfig";
        var colorFilter = "@ViewBag.ColorFilter";
    </script>
    <script src="~/Scripts/Lib/jquery.min.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/json2.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/utils/jquery.button.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/Pager/jpager.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/Jlinq/jlinq.jquery.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/gridscroller.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/autocomplete/jquery.autocomplete.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/Number/jquery.number_format.js" type="text/javascript"></script>
    <script src="~/Scripts/Common.js" type="text/javascript"></script>
    <script src="~/Views/Customer/Scripts/MemberManagement.js?ver=@WebSettings.Version" type="text/javascript"></script>
</body>
</html>