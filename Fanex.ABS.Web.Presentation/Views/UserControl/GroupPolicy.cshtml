@using Fanex.ABS.Infrastructure.Configurations;
@using Fanex.ABS.Web.Controllers.Helper;
@{
    Layout = null;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Group Policy</title>
    <link href="~/Content/Ocean/Grid.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Ocean/StyleSheet.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/Lib/jquery.1.6.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/gridscroller.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/Template/jquery.tmpl.js" type="text/javascript"></script>
    <script src="~/Scripts/Common.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/utils/jquery.button.js" type="text/javascript"></script>
</head>
<body>
    <form id="form1" runat="server">
    </form>
    <input id="hGroupName" type="hidden" value="@ViewBag.DeptName" />
    <input id="hSystemName" type="hidden" value="@ViewBag.SystemName" />
    <input id="hUserID" type="hidden" value="@AppSession.UserId.ToString()" />
    <input id="hABDGroupID" type="hidden" value="@ViewBag.ABDGroupID" />
    <div class="pageTitle">
        Group Policy</div>
    <div id="msg" style="width: 566px">
    </div>
    <div class="contentSection">
        <div id="policyGrid" class="content-warper hidden">
            <div class="content-header clearfix">
                <div class="header-scroll">
                    <table class="tbl-header-scroll">
                        <tr>
                            <td rowspan="2" style="border-bottom: none 0px;">
                                <div class="col360 c">
                                    Function</div>
                            </td>
                            <td colspan="2">
                                <div class="c">
                                    Group Permission</div>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: none 0px;">
                                <div class="col100 c">
                                    Read</div>
                            </td>
                            <td style="border-bottom: none 0px;">
                                <div class="col100 c">
                                    Host</div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="content-body clearfix">
                <div class="body-scroll">
                    <table class="tbl-body-scroll">
                        <tbody id="tbodyGP">
                        </tbody>
                    </table>
                    <script id="scriptTemplate" type="text/html">
                        <tr level="${level}" _id="${ID}" parentID="${ParentId}" TotalSub="${TotalSub}"><td>
                                <div class="col360 l">
                                    <span icon="true"
                                    {{if TotalSub != 0}}
                                        class="tree-expanded">
                                    {{else}}
                                        >&nbsp;
                                    {{/if}}
                                    </span>
                                    <span funcname="true">${FuncDesc}</span>
                                    <input type="hidden" value="${level}" level="true" />
                                    <input type="hidden" value="${ID}" funcid="true" />
                                    <input type="hidden" value="${TotalSub}" TotalSub="true" />
                                </div>
                            </td><td>
                                <div class="col100 c">
                                    <input type="checkbox" cbxRead="true"
                                    {{if IsGroupRead}}
                                        checked="checked"
                                    {{/if}}
                                     />
                                </div>
                            </td><td>
                                <div class="col100 c">
                                    <input type="checkbox" cbxHost="true"
                                    {{if IsGroupHost}}
                                        checked="checked"
                                    {{/if}}
                                    />
                                </div>
                            </td>
                        </tr>
                    </script>
                </div>
            </div>
        </div>
    </div>
    <div>
        <input id="btnUpdate" type="button" class="btn hidden" value="Update" style="margin-left: 2px" />
    </div>
    <script src="~/Views/UserControl/Scripts/GroupPolicy.js?ver=@WebSettings.Version" type="text/javascript"></script>
</body>
</html>