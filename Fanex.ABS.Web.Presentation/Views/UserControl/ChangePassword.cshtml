@using Fanex.ABS.Infrastructure.Configurations;
@{
    Layout = null;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <link href="~/Content/Ocean/Grid.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Ocean/StyleSheet.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/Lib/jquery.min.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/json2.js" type="text/javascript"></script>
    <script src="~/Scripts/Lib/utils/jquery.button.js" type="text/javascript"></script>
    <script src="~/Scripts/Common.js" type="text/javascript"></script>
</head>
<body>
    <form runat="server">
    <input type="hidden" id="hiddenUserId" runat="server" value="@Fanex.ABS.Web.Controllers.Helper.AppSession.UserId.ToString()" />
    </form>
    <div class="pageTitle">
        Change Password</div>
    <div id="msg">
    </div>
    <div class="filterSection">
        <div id="msg">
        </div>
        <table id="tblAddMember" border="0" cellpadding="2">
            <tr>
                <td class="r w120">
                    <label>
                        Password:</label>
                </td>
                <td class="l">
                    <input type="password" id="txtPassword" class="w120 inputtext" />
                </td>
            </tr>
            <tr>
                <td class="r">
                    <label>
                        Confirm Password:</label>
                </td>
                <td class="b l">
                    <input type="password" id="txtConfirmPassword" class="w120 inputtext" />
                </td>
            </tr>
            <tr>
                <td class="c" colspan="2">
                    <input type="button" value="Submit" id="btnSubmit" class="btn" onclick="javascript:changePwdHandler.btnSubmit();" />
                    <input type="button" value="Reset" id="btnReset" class="btn" onclick="javascript:changePwdHandler.btnReset();" />
                </td>
            </tr>
        </table>
    </div>
    <script type="text/javascript">
        var strPasswordEmpty = "@ViewBag.strPasswordEmpty";
        var strPassswordAtLeast4 = "@ViewBag.strPassswordAtLeast4";
        var strConfirmPassword = "@ViewBag.strConfirmPassword";
        var strPasswordNotCorrectConfirm = "@ViewBag.strPasswordNotCorrectConfirm";
    </script>
    <script src="~/Views/UserControl/Scripts/ChangePassword.js?ver=@WebSettings.Version" type="text/javascript"></script>
</body>
</html>